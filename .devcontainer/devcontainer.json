{
  "name": "Jekyll (GitHub Pages)",
  "image": "mcr.microsoft.com/devcontainers/ruby:3.2-bookworm",
  "containerEnv": {
    "PAGES_REPO_NWO": "OWNER/REPO",
    "JEKYLL_ENV": "development"
  },
  "postCreateCommand": "bundle config set --local path vendor/bundle && bundle install",
  "forwardPorts": [4000, 35729],
  "portsAttributes": {
    "4000": {
      "label": "Jekyll Web Server",
      "onAutoForward": "openPreview"
    },
    "35729": {
      "label": "LiveReload",
      "onAutoForward": "silent"
    }
  },
  "remoteUser": "vscode"
}
